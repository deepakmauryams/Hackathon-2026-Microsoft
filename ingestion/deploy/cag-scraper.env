# Shared by systemd and the cag-scraper command; keep shell-compatible assignments.
QDRANT_URL=http://127.0.0.1:6333
NO_PROXY=127.0.0.1,localhost
CAG_COLLECTION=cag_catalogue_v1
CAG_DATA_DIR=/data/files/cag/worker-native/pipeline
CAG_MODEL_CACHE=/data/files/cag/worker-native/models
HF_HOME=/data/files/cag/worker-native/models/huggingface
TIKTOKEN_CACHE_DIR=/data/files/cag/worker-native/models/tiktoken
HOME=/data/files/cag/worker-native/models
XDG_CACHE_HOME=/data/files/cag/worker-native/models/xdg
TMPDIR=/data/files/cag/worker-native/tmp
CAG_MIN_FREE_BYTES=5368709120
CAG_THREADS=2
OMP_NUM_THREADS=2
OMP_THREAD_LIMIT=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
HF_HUB_DISABLE_TELEMETRY=1